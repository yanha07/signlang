    "    seq_dirs = sorted([d for d in os.listdir(class_dir) if os.path.isdir(os.path.join(class_dir, d))])\\n\n",
    "\\n\n",
    "    for seq_id in seq_dirs:\\n\n",
    "        seq_dir = os.path.join(class_dir, seq_id)\\n\n",
    "        frames = []\\n\n",
    "        ok = True\\n\n",
    "\\n\n",
    "        for f in range(SEQUENCE_LENGTH):\\n\n",
    "            fp = os.path.join(seq_dir, f'{f}.npy')\\n\n",
    "            if not os.path.exists(fp):\\n\n",
    "                ok = False\\n\n",
    "                break\\n\n",
    "\\n\n",
    "            arr = np.load(fp)\\n\n",
    "            if arr.shape[0] != FRAME_SIZE:\\n\n",
