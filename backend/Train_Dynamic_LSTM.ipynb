    "print('Loaded y shape:', y.shape)\\n\n",
    "print('Bad sequences skipped:', bad_sequences)\\n\n",
    "print('Total classes:', len(classes))\\n\n",
    "\\n\n",
    "if X.shape[0] == 0:\\n\n",
    "    raise RuntimeError('No valid sequences loaded. Check DATA_PATH structure.')"
