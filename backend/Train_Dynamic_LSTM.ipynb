    "\\n\n",
    "    LSTM(64, return_sequences=False, activation='tanh'),\\n\n",
    "    BatchNormalization(),\\n\n",
    "\\n\n",
    "    Dense(64, activation='relu'),\\n\n",
    "    Dropout(0.2),\\n\n",
    "\\n\n",
    "    Dense(len(classes), activation='softmax')\\n\n",
    "])\\n\n",
    "\\n\n",
    "model.compile(\\n\n",
