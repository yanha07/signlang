    "from tensorflow.keras.optimizers import Adam\\n\n",
    "\\n\n",
    "# ====== CONFIG ======\\n\n",
    "DATA_PATH = '/content/MP_Data'\\n\n",
    "SEQUENCE_LENGTH = 30\\n\n",
    "FRAME_SIZE = 1662\\n\n",
    "MODEL_PATH = '/content/dynamic_lstm.keras'\\n\n",
    "LABELS_PATH = '/content/dynamic_labels.npy'\\n\n",
    "# ===================="
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print('DATA_PATH exists:', os.path.exists(DATA_PATH))\\n\n",
    "if os.path.exists(DATA_PATH):\\n\n",
    "    cls = sorted([d for d in os.listdir(DATA_PATH) if os.path.isdir(os.path.join(DATA_PATH, d))])\\n\n",
    "    print('Class folders:', len(cls))\\n\n",
    "    print('Sample classes:', cls[:10])"
   ]
  },
  {
   "cell_type": "code",
